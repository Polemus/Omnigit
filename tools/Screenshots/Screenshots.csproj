<Project Sdk="Microsoft.NET.Sdk">

  <!-- Renders the README's screenshots from the real app, offscreen. Not shipped: it
       references the app and adds Avalonia's headless platform, which renders through
       Skia exactly as a window does, so the pixels are the app's own. See Program.cs for
       how to run it and what it expects to find. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Omnigit\Omnigit.csproj" />
    <PackageReference Include="Avalonia.Headless" Version="12.1.2" />
  </ItemGroup>

</Project>
