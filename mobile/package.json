    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "update:preview": "npx eas update --channel preview --environment preview",
    "update:production": "npx eas update --channel production --environment production",
    "typecheck": "tsc --noEmit",
    "check:manifests": "node scripts/check-manifests.mjs",
    "check": "npm run check:manifests && npm run typecheck && npm run lint",
    "lint": "expo lint",
    "postinstall": "patch-package"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "android": {
        "buildFromSource": [
          "expo-ui"
        ]
      }
    }
  }
