<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <RootNamespace>Omnigit</RootNamespace>
    <AssemblyName>Omnigit</AssemblyName>
    <Version>0.5.0</Version>
    <Company>Polemus</Company>
    <Product>Omnigit</Product>
    <ApplicationIcon>Assets/omnigit.ico</ApplicationIcon>
    <InvariantGlobalization>true</InvariantGlobalization>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
  </PropertyGroup>

  <ItemGroup>
    <!-- So the tests can reach helpers that are internal because nothing in the app
         calls them directly - DesktopIntegration's desktop-entry rewrite, so far. -->
    <InternalsVisibleTo Include="Omnigit.Tests" />
  </ItemGroup>

  <ItemGroup>
    <AvaloniaResource Include="Assets\**" />

    <!-- Site descriptions shipped with the app. Loaded by HostProviderRegistry
         through the same code path as user-written manifests. -->
    <EmbeddedResource Include="HostProviders\Manifests\*.json" />

    <!-- The starting files a new repository can be given. Embedded rather than written
         out in C# because a licence has to be reproduced exactly. LogicalName is set
         explicitly: MSBuild's default mangles anything that isn't an identifier, which
         would turn C++ into C__ in the picker. -->
    <EmbeddedResource Include="Resources\Gitignore\*.gitignore"
                      LogicalName="Omnigit.Resources.Gitignore.%(Filename)%(Extension)" />
    <EmbeddedResource Include="Resources\Licences\*.txt"
                      LogicalName="Omnigit.Resources.Licences.%(Filename)%(Extension)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" Version="12.1.2" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.2" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.2" />
    <PackageReference Include="Avalonia.Fonts.Inter" Version="12.1.2" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="FluentAvaloniaUI" Version="3.1.0" />
    <PackageReference Include="AvaloniaUI.DiagnosticsSupport" Version="2.2.3">
      <IncludeAssets Condition="'$(Configuration)' != 'Debug'">None</IncludeAssets>
      <PrivateAssets Condition="'$(Configuration)' != 'Debug'">All</PrivateAssets>
    </PackageReference>
    <PackageReference Include="LibGit2Sharp" Version="0.32.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.12" />
    <PackageReference Include="TextMateSharp" Version="2.0.4" />
    <PackageReference Include="TextMateSharp.Grammars" Version="2.0.4" />
  </ItemGroup>

</Project>
