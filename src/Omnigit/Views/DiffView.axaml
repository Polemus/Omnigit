<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Omnigit.ViewModels"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="800" d:DesignHeight="400"
             x:Class="Omnigit.Views.DiffView"
             x:DataType="vm:ChangeViewerViewModel">

    <!--  One changed file, filling whatever pane it is given: its header, and below it
         whatever the chosen viewer drew. What the body looks like is the viewer's
         business - the line diff, an image comparison, or a plugin's control - and the
         viewer owns its own scrolling, so the scrollbars sit against the pane's edges. -->
    <Border Background="{DynamicResource SurfaceBackground}"
            BorderBrush="{DynamicResource BorderSubtle}"
            BorderThickness="1"
            CornerRadius="8"
            ClipToBounds="True">
        <Grid RowDefinitions="Auto,Auto,*">

            <!-- File header -->
            <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto,Auto" ColumnSpacing="9" Margin="13,10">
                <TextBlock Grid.Column="0"
                           Classes="statusGlyph"
                           Classes.added="{Binding Change.IsAdded}"
                           Classes.modified="{Binding Change.IsModified}"
                           Classes.deleted="{Binding Change.IsDeleted}"
                           Classes.renamed="{Binding Change.IsRenamed}"
                           Text="{Binding Change.StatusGlyph}"
                           VerticalAlignment="Center" />

                <TextBlock Grid.Column="1" Classes="mono" Text="{Binding Change.Path}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="10"
                            VerticalAlignment="Center">
                    <TextBlock Classes="mono" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusAdded}"
                               Text="{Binding Change.Additions, StringFormat='+{0}'}" />
                    <TextBlock Classes="mono" FontWeight="SemiBold"
                               Foreground="{DynamicResource StatusDeleted}"
                               Text="{Binding Change.Deletions, StringFormat='-{0}'}" />
                </StackPanel>

                <!-- Only when there is a choice: a text file has one viewer and no
                     reason to show a picker with one entry in it. -->
                <ComboBox Grid.Column="3" MinWidth="110"
                          IsVisible="{Binding HasChoice}"
                          ItemsSource="{Binding Viewers}"
                          SelectedItem="{Binding SelectedViewer}"
                          ToolTip.Tip="{Loc 'How to show this file'}">
                    <ComboBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:ViewerOption">
                            <TextBlock Text="{Binding Name}" />
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
            </Grid>

            <Border Grid.Row="1" Classes="divider" />

            <ContentControl Grid.Row="2" Content="{Binding Content}"
                            HorizontalContentAlignment="Stretch"
                            VerticalContentAlignment="Stretch" />

            <TextBlock Grid.Row="2" Classes="muted" TextWrapping="Wrap" Margin="13"
                       IsVisible="{Binding HasProblem}"
                       Text="{Binding Problem}" />
        </Grid>
    </Border>
</UserControl>
