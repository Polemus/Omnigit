<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Omnigit.ViewModels"
             xmlns:m="using:Omnigit.Models"
             xmlns:views="using:Omnigit.Views"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d" d:DesignWidth="1280" d:DesignHeight="760"
             x:Class="Omnigit.Views.GraphView"
             x:DataType="vm:MainWindowViewModel">

    <Design.DataContext>
        <vm:MainWindowViewModel />
    </Design.DataContext>

    <!--
        The commit graph, given the whole window.

        It began as a gutter in the history list and could not stay there: ten lanes is
        140 pixels, which is most of that pane, and a repository with the branching of
        the kernel would leave nothing for the summary the lanes exist to annotate. Here
        the lanes can take what they need and the columns beside them still have room.
    -->
    <Grid RowDefinitions="Auto,Auto,*" Background="{DynamicResource AppBackground}">

        <!-- ===================== Header ===================== -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14"
              Margin="18,16,18,12">
            <Button Grid.Column="0" Classes="secondary"
                    Command="{Binding CloseGraphCommand}"
                    Content="← Back to repository" />

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Classes="h2" Text="{Binding GraphTitle}" />
                <TextBlock Classes="muted" Text="{Binding GraphSubtitle}" />
            </StackPanel>

            <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                       IsVisible="{Binding IsGraphLoading}"
                       Text="Reading the history…" />
        </Grid>

        <Border Grid.Row="1" Classes="divider" />

        <!-- ===================== The graph ===================== -->
        <ListBox Grid.Row="2" Classes="plain graphList"
                 ItemsSource="{Binding GraphCommits}"
                 SelectedItem="{Binding SelectedGraphCommit, Mode=TwoWay}">
            <ListBox.ContextFlyout>
                <MenuFlyout Placement="Pointer">
                    <MenuItem Header="Copy SHA" Command="{Binding CopyGraphCommitShaCommand}" />
                    <MenuItem Header="Copy summary" Command="{Binding CopyGraphCommitSummaryCommand}" />
                </MenuFlyout>
            </ListBox.ContextFlyout>

            <ListBox.ItemTemplate>
                <DataTemplate x:DataType="m:CommitInfo">
                    <!-- No vertical margin on the row: the graph column runs edge to
                         edge, and any space between two rows would be a gap in the
                         line it draws. The padding lives on the columns beside it. -->
                    <Grid ColumnDefinitions="Auto,*,Auto,Auto,Auto" ColumnSpacing="14"
                          Margin="14,0,18,0">
                        <views:CommitGraphCell Grid.Column="0"
                                               VerticalAlignment="Stretch"
                                               Row="{Binding Graph}"
                                               LaneCount="{Binding $parent[ListBox].((vm:MainWindowViewModel)DataContext).GraphLanes}" />

                        <!-- Summary, with the branches that end here in front of it:
                             on a graph of every branch, that is what says which lane
                             is which. -->
                        <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                    Margin="0,8" VerticalAlignment="Center">
                            <ItemsControl ItemsSource="{Binding Refs}" IsVisible="{Binding HasRefs}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="refBadge">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <ItemsControl ItemsSource="{Binding Tags}" IsVisible="{Binding HasTags}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" Spacing="4" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border Classes="tagBadge">
                                            <TextBlock Text="{Binding}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Classes="body" Text="{Binding Summary}"
                                       TextTrimming="CharacterEllipsis"
                                       VerticalAlignment="Center" />
                        </StackPanel>

                        <TextBlock Grid.Column="2" Classes="muted" VerticalAlignment="Center"
                                   Text="{Binding AuthorName}" />
                        <TextBlock Grid.Column="3" Classes="muted" VerticalAlignment="Center"
                                   MinWidth="110" Text="{Binding RelativeTime}" />
                        <TextBlock Grid.Column="4" Classes="muted" VerticalAlignment="Center"
                                   FontFamily="{DynamicResource MonoFont}"
                                   Text="{Binding ShortSha}" />
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>
    </Grid>
</UserControl>
