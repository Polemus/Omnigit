<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vv="using:Omnigit.Views.Viewers"
             x:Class="Omnigit.Views.Viewers.ImageCompareView">

    <Grid RowDefinitions="Auto,*">

        <!-- Mode, slider and what changed about the file itself. The mode and slider
             only appear when there are two images to compare. -->
        <Grid Grid.Row="0" ColumnDefinitions="Auto,*,Auto" ColumnSpacing="14" Margin="13,8">
            <StackPanel x:Name="ModePanel" Grid.Column="0" Orientation="Horizontal" Spacing="4"
                        VerticalAlignment="Center">
                <RadioButton x:Name="SwipeMode" GroupName="imageMode" IsChecked="True"
                             Content="{Loc 'Swipe'}" />
                <RadioButton x:Name="OnionMode" GroupName="imageMode"
                             Content="{Loc 'Onion skin'}" />
            </StackPanel>

            <Slider x:Name="Mix" Grid.Column="1" Minimum="0" Maximum="1" Value="0.5"
                    VerticalAlignment="Center" MaxWidth="360" HorizontalAlignment="Left"
                    MinWidth="160" />

            <TextBlock x:Name="Facts" Grid.Column="2" Classes="caption mono"
                       VerticalAlignment="Center" />
        </Grid>

        <!-- Down-only: a picture larger than the pane shrinks to fit, keeping its
             aspect ratio, and one smaller is drawn at its real size rather than blown
             up into a blur. Both images sit at the top-left of a canvas the size of
             the larger one, so a resize reads as the edges moving rather than as
             everything shifting. -->
        <Viewbox x:Name="Fit" Grid.Row="1" Stretch="Uniform" StretchDirection="DownOnly"
                 Margin="13,0,13,13" HorizontalAlignment="Center" VerticalAlignment="Top">
            <Panel x:Name="Stage" HorizontalAlignment="Left" VerticalAlignment="Top">
                <vv:Checkerboard x:Name="Board" />
                <Image x:Name="OldImage" Stretch="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Image x:Name="NewImage" Stretch="None"
                       HorizontalAlignment="Left" VerticalAlignment="Top" />
                <Rectangle x:Name="Divider" Width="2" HorizontalAlignment="Left"
                           Fill="{DynamicResource AccentBrush}" IsHitTestVisible="False" />
            </Panel>
        </Viewbox>

        <TextBlock x:Name="Message" Grid.Row="1" Classes="muted" TextWrapping="Wrap"
                   Margin="13" HorizontalAlignment="Center" VerticalAlignment="Center" />
    </Grid>
</UserControl>
