<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:m="using:Omnigit.Models"
             xmlns:v="using:Omnigit.Views"
             x:Class="Omnigit.Views.Viewers.LineDiffView"
             x:DataType="m:FileChange">

    <!--  The unified diff: what the text viewer shows, and what every file showed
         before there were viewers. It owns both scroll directions, so the scrollbars
         sit against the edges of the pane rather than against the end of the text. -->
    <ScrollViewer HorizontalScrollBarVisibility="Auto"
                  VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding Diff}">
            <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="m:DiffLine">
                    <Border Classes="diffRow"
                            Classes.add="{Binding IsAdded}"
                            Classes.remove="{Binding IsRemoved}"
                            Classes.hunk="{Binding IsHunkHeader}">
                        <Grid ColumnDefinitions="Auto,Auto,*">

                            <!-- Line-number gutter -->
                            <Border Grid.Column="0"
                                    Classes="diffGutter"
                                    Classes.add="{Binding IsAdded}"
                                    Classes.remove="{Binding IsRemoved}"
                                    Classes.hunk="{Binding IsHunkHeader}"
                                    Padding="9,2">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <TextBlock Classes="diffNumber" Text="{Binding OldNumber}" />
                                    <TextBlock Classes="diffNumber" Text="{Binding NewNumber}" />
                                </StackPanel>
                            </Border>

                            <!-- +/-/space marker -->
                            <TextBlock Grid.Column="1"
                                       Classes="diffText"
                                       Classes.add="{Binding IsAdded}"
                                       Classes.remove="{Binding IsRemoved}"
                                       Classes.hunk="{Binding IsHunkHeader}"
                                       Text="{Binding Marker}"
                                       Width="17" TextAlignment="Center"
                                       Padding="0,2" />

                            <!-- Code. The text is set by SyntaxText, which
                                 builds it as coloured runs where the file has
                                 a grammar and as plain text where it does not -
                                 so this must not also bind Text, or the two
                                 would fight over the same property. -->
                            <TextBlock Grid.Column="2"
                                       Classes="diffText"
                                       Classes.add="{Binding IsAdded}"
                                       Classes.remove="{Binding IsRemoved}"
                                       Classes.hunk="{Binding IsHunkHeader}"
                                       v:SyntaxText.Line="{Binding}"
                                       Padding="0,2,24,2" />
                        </Grid>
                    </Border>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </ScrollViewer>
</UserControl>
